---
import ExperienceLayout from "../layouts/ExperienceLayout.astro";
import { articles } from "../data/articles";
import { healthNews } from "../data/news";
import { learningVideos } from "../data/videos";

const featuredArticles = articles.filter((article) => article.featured).slice(0, 2);
const featuredNews = healthNews.slice(0, 2);
const featuredVideos = learningVideos.slice(0, 2);
---
<ExperienceLayout
  title="RIDWANAH — Your health, your vibe, your space"
  description="Health without the lecture. Discover short lessons, quizzes, useful health tools and source-linked updates from RIDWANAH."
  activeSection="home"
>
  <div class="rw-home">
    <section class="rw-hero" aria-labelledby="home-title">
      <div class="rw-hero-copy">
        <span class="rw-eyebrow"><i></i> HEALTH, WITHOUT THE LECTURE.</span>
        <h1 id="home-title">Your health.<br /><span>Your vibe.</span><br />Your space.</h1>
        <p>Real talk about your body, mind and everyday wellbeing. Discover useful stuff, ask better questions and learn without the judgement.</p>
        <div class="rw-hero-actions">
          <a class="rw-button rw-button-lime" href="/discover">Explore RIDWANAH <span aria-hidden="true">↗</span></a>
          <a class="rw-button rw-button-ghost" href="/play">Take a quick quiz <span aria-hidden="true">→</span></a>
        </div>
        <div class="rw-hero-footnote"><span aria-hidden="true">✳</span> Evidence-informed. Everyday language. People first.</div>
      </div>
      <div class="rw-hero-art" aria-label="RIDWANAH health discovery artwork">
        <div class="rw-orbit rw-orbit-one"></div><div class="rw-orbit rw-orbit-two"></div>
        <div class="rw-art-sticker rw-art-sticker-top"><span>BODY</span><strong>TALK</strong></div>
        <div class="rw-art-shape"><span>✳</span></div>
        <div class="rw-art-sticker rw-art-sticker-bottom"><span>LEARN IT.</span><span>LIVE IT.</span></div>
        <span class="rw-art-spark rw-spark-one" aria-hidden="true">✦</span><span class="rw-art-spark rw-spark-two" aria-hidden="true">＋</span>
        <span class="rw-art-caption">A little more curious.<br />A lot more informed.</span>
      </div>
    </section>

    <section class="rw-quick-actions" aria-labelledby="quick-actions-title">
      <div class="rw-section-heading">
        <div><span class="rw-eyebrow rw-eyebrow-dark">YOUR SHORTCUTS</span><h2 id="quick-actions-title">Jump right in.</h2></div>
        <span class="rw-section-aside">PICK YOUR NEXT MOVE <span aria-hidden="true">↘</span></span>
      </div>
      <div class="rw-action-grid">
        <a class="rw-action-card rw-action-alert" href="/alert">
          <span class="rw-action-icon" aria-hidden="true">◉</span><span class="rw-card-kicker">STAY IN THE KNOW</span>
          <strong>RIDWANAH Alert</strong><small>Important health updates, with context.</small><span class="rw-card-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="rw-action-card rw-action-cycle" href="/my-health">
          <span class="rw-action-icon" aria-hidden="true">♡</span><span class="rw-card-kicker">GET TO KNOW YOUR BODY</span>
          <strong>Cycle tracker</strong><small>A privacy-first tool concept for My Health.</small><span class="rw-card-arrow" aria-hidden="true">↗</span>
          <span class="rw-preview-tag">PREVIEW</span>
        </a>
        <a class="rw-action-card rw-action-ask" href="/ask">
          <span class="rw-action-icon" aria-hidden="true">✦</span><span class="rw-card-kicker">NO JUDGEMENT ZONE</span>
          <strong>Ask RIDWANAH</strong><small>Find clear answers in our current library.</small><span class="rw-card-arrow" aria-hidden="true">↗</span>
          <span class="rw-preview-tag">AI PREVIEW</span>
        </a>
        <a class="rw-action-card rw-action-play" href="/play">
          <span class="rw-action-icon" aria-hidden="true">◇</span><span class="rw-card-kicker">LEARN SOMETHING</span>
          <strong>Play & learn</strong><small>Quick questions. Useful takeaways.</small><span class="rw-card-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="rw-alert-strip" aria-labelledby="alert-strip-title">
      <div class="rw-alert-strip-icon" aria-hidden="true">◉</div>
      <div class="rw-alert-strip-copy">
        <span class="rw-eyebrow">THE LATEST, WITH CONTEXT</span>
        <h2 id="alert-strip-title">Health updates worth understanding.</h2>
        <p>Source-linked public-health updates. Check the date and original publisher — this is a curated archive, not a live emergency alert service.</p>
      </div>
      <a class="rw-button rw-button-dark" href="/alert">Open Alert <span aria-hidden="true">↗</span></a>
    </section>

    <section class="rw-content-section" aria-labelledby="discover-title">
      <div class="rw-section-heading">
        <div><span class="rw-eyebrow rw-eyebrow-dark">FRESH FROM THE FEED</span><h2 id="discover-title">Something good to know.</h2><p>Health knowledge that fits into real life — not just long reads.</p></div>
        <a class="rw-text-link" href="/discover">Explore Discover <span aria-hidden="true">↗</span></a>
      </div>
      <div class="rw-story-grid">
        {featuredArticles.map((article, index) => (
          <article class:list={["rw-story-card", index === 1 && "rw-story-tone-2"]}>
            <div class="rw-story-art"><span>{index === 0 ? "EVERYDAY" : "BODY BASICS"}</span><strong>{index === 0 ? "CLEAN" : "MOVE"}</strong><i aria-hidden="true">{index === 0 ? "✳" : "↗"}</i></div>
            <div class="rw-story-copy">
              <div class="rw-story-meta"><span>{article.category}</span><span>{article.readTime}</span></div>
              <h3><a href={"/health/" + article.slug + "/"}>{article.title}</a></h3>
              <p>{article.description}</p>
              <div class="rw-review-note">Educational draft · Medical review pending</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="rw-content-section" aria-labelledby="shorts-title">
      <div class="rw-section-heading">
        <div><span class="rw-eyebrow rw-eyebrow-dark">WATCH, PAUSE, PICK SOMETHING UP</span><h2 id="shorts-title">Small watch. Big takeaway.</h2><p>Short learning videos from public-health publishers.</p></div>
        <a class="rw-text-link" href="/watch">See all videos <span aria-hidden="true">↗</span></a>
      </div>
      <div class="rw-video-grid">
        {featuredVideos.map((video, index) => (
          <article class="rw-video-card">
            <a class:list={["rw-video-art", index === 0 ? "rw-video-art-mint" : "rw-video-art-lilac"]} href="/watch" aria-label={"Explore the video library: " + video.title}>
              <span class="rw-video-play" aria-hidden="true">▶</span><span class="rw-video-duration">VIDEO</span>
            </a>
            <div class="rw-video-copy"><span>{video.publisher} · {video.category}</span><h3>{video.title}</h3><p>{video.summary}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="rw-play-banner" aria-labelledby="play-banner-title">
      <div class="rw-play-banner-mark" aria-hidden="true">?</div>
      <div><span class="rw-eyebrow">THINK YOU KNOW YOUR HEALTH INFO?</span><h2 id="play-banner-title">Let's put that scroll knowledge to work.</h2><p>Test your health-info instincts in a short, no-pressure quiz.</p></div>
      <a class="rw-button rw-button-lime" href="/play">Let's play <span aria-hidden="true">↗</span></a>
    </section>

    <p class="rw-home-disclaimer">RIDWANAH provides general health education, not diagnosis or personal medical advice. Health guides currently display their pending medical-review status.</p>
  </div>
</ExperienceLayout>

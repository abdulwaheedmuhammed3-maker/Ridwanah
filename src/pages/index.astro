---
import BaseLayout from "../layouts/BaseLayout.astro";

const topics = [
  { number: "01", title: "Understand your health", text: "Build a stronger foundation with clear explanations of how the body works.", tag: "Health basics", tone: "mint" },
  { number: "02", title: "Make prevention practical", text: "Explore everyday habits, screenings, hygiene, and ways to reduce health risks.", tag: "Prevention", tone: "coral" },
  { number: "03", title: "Feel informed, not overwhelmed", text: "Find respectful, accessible guidance on topics that affect everyday life.", tag: "Wellbeing", tone: "blue" }
];

const areas = [
  { title: "Health education", text: "Straightforward explainers that make health topics easier to understand.", icon: "✳", href: "#education", tone: "mint" },
  { title: "Prevention & healthy living", text: "Practical information for building healthier everyday habits.", icon: "＋", href: "#prevention", tone: "coral" },
  { title: "Watch & learn", text: "Short videos and visual explainers designed to make learning stick.", icon: "▷", href: "#watch", tone: "blue" },
  { title: "Health awareness", text: "Campaigns and important public-health conversations, made clearer.", icon: "◎", href: "#awareness", tone: "lavender" }
];
---
<BaseLayout title="Ridwanah — Your Health Learning Space">
  <div class="dashboard-app">
    <aside class="sidebar" aria-label="Main sidebar">
      <a class="sidebar-brand" href="/" aria-label="Ridwanah home">
        <img src="/brand/ridwanah-logo.svg" alt="Ridwanah — Digital Health Education" />
      </a>

      <div class="sidebar-label">WORKSPACE</div>
      <nav class="sidebar-nav" aria-label="Desktop navigation">
        <a class="nav-item active" href="#overview"><span class="nav-icon">⌂</span><span>Overview</span><span class="nav-current"></span></a>
        <a class="nav-item" href="#education"><span class="nav-icon">▤</span><span>Health library</span></a>
        <a class="nav-item" href="#prevention"><span class="nav-icon">＋</span><span>Prevention</span></a>
        <a class="nav-item" href="#watch"><span class="nav-icon">▷</span><span>Watch & learn</span></a>
        <a class="nav-item" href="#awareness"><span class="nav-icon">◎</span><span>Awareness</span></a>
      </nav>

      <div class="sidebar-label sidebar-label-spaced">DISCOVER</div>
      <nav class="sidebar-nav" aria-label="Discover navigation">
        <a class="nav-item" href="#about"><span class="nav-icon">♡</span><span>About Ridwanah</span></a>
        <a class="nav-item" href="#standards"><span class="nav-icon">✓</span><span>Our content standards</span></a>
      </nav>

      <div class="sidebar-bottom">
        <div class="sidebar-tip-icon">✳</div>
        <strong>Knowledge is a healthy start.</strong>
        <p>Learn at your pace. Ask questions. Speak with a qualified professional when you need personal care.</p>
        <a href="#about">Our approach <span>↗</span></a>
      </div>
      <div class="sidebar-copyright">© {new Date().getFullYear()} Ridwanah</div>
    </aside>

    <div class="main-column">
      <header class="topbar">
        <div class="topbar-context">
          <span class="topbar-kicker">RIDWANAH /</span>
          <span class="topbar-current">Your learning space</span>
        </div>
        <div class="topbar-right">
          <span class="topbar-status"><i></i> General health education</span>
          <a class="topbar-cta" href="#education">Explore library <span>↗</span></a>
        </div>
      </header>

      <main class="dashboard-content" id="overview">
        <section class="welcome-panel">
          <div class="welcome-copy">
            <div class="eyebrow"><span class="eyebrow-line"></span> YOUR HEALTH, MADE CLEARER</div>
            <h1>Know more.<br /><span>Live healthier.</span></h1>
            <p>Good health decisions begin with good information. Explore clear, practical health education that helps you understand your body, make informed choices, and know when to seek professional care.</p>
            <div class="welcome-actions">
              <a class="button button-primary" href="#education">Explore health topics <span aria-hidden="true">↗</span></a>
              <a class="text-link" href="#about">Get to know Ridwanah <span aria-hidden="true">→</span></a>
            </div>
            <div class="welcome-note"><span>✳</span> Reliable knowledge. Everyday language. A healthier you.</div>
          </div>
          <div class="welcome-art" aria-label="Health learning illustration">
            <div class="art-ring ring-one"></div>
            <div class="art-ring ring-two"></div>
            <div class="art-card">
              <div class="art-card-top"><span>THE RIDWANAH WAY</span><i></i></div>
              <div class="art-symbol"><span>+</span><b>♡</b></div>
              <div class="art-message">Health information<br /><em>you can understand.</em></div>
              <div class="art-card-bottom"><span>LEARN</span><span>PREVENT</span><span>THRIVE</span></div>
            </div>
            <div class="art-float float-top"><span>✳</span><div><strong>Learn with clarity</strong><small>Simple, useful explanations</small></div></div>
            <div class="art-float float-bottom"><span>♡</span><div><strong>Put knowledge to use</strong><small>Small steps for everyday life</small></div></div>
          </div>
        </section>

        <section class="principles-row" aria-label="Our content principles">
          <div><span>✓</span> Evidence-informed content</div>
          <div><span>◎</span> Clear, accessible language</div>
          <div><span>♡</span> People-first education</div>
        </section>

        <section class="content-section" id="education">
          <div class="section-heading">
            <div>
              <div class="eyebrow"><span class="eyebrow-line"></span> A BETTER WAY TO LEARN</div>
              <h2>Health knowledge should feel <em>within reach.</em></h2>
            </div>
            <a class="section-link" href="#prevention">Browse learning areas <span>→</span></a>
          </div>
          <p class="section-intro">Not medical jargon. Not confusing advice. Just approachable education to help you ask better questions and take more informed steps.</p>
          <div class="topic-grid">
            {topics.map((topic) => (
              <article class="topic-card">
                <div class="topic-card-top"><span>{topic.number}</span><span class="topic-arrow">↗</span></div>
                <div class:list={["topic-tag", topic.tone]}>{topic.tag}</div>
                <h3>{topic.title}</h3>
                <p>{topic.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="content-section explore-section" id="prevention">
          <div class="section-heading">
            <div>
              <div class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> EXPLORE RIDWANAH</div>
              <h2>Choose what you want to <em>learn today.</em></h2>
            </div>
            <span class="section-caption">FOUR LEARNING AREAS</span>
          </div>
          <div class="area-grid">
            {areas.map((area, index) => (
              <a class="area-card" href={area.href}>
                <div class="area-card-top"><span class:list={["area-icon", area.tone]}>{area.icon}</span><span class="area-index">0{index + 1}</span></div>
                <h3>{area.title}</h3>
                <p>{area.text}</p>
                <span class="area-link">Explore <span aria-hidden="true">↗</span></span>
              </a>
            ))}
          </div>
        </section>

        <section class="content-section awareness-panel" id="awareness">
          <div class="awareness-icon">◎</div>
          <div class="awareness-copy">
            <div class="eyebrow"><span class="eyebrow-line"></span> STAY INFORMED</div>
            <h2>Health awareness that connects to real life.</h2>
            <p>Explore public-health campaigns, important observances, and carefully explained health updates. This section will grow as reviewed content is added.</p>
          </div>
          <span class="coming-soon">AWARENESS HUB IN DEVELOPMENT</span>
        </section>

        <section class="content-section watch-section" id="watch">
          <div class="watch-panel">
            <div class="watch-content">
              <div class="eyebrow"><span class="eyebrow-line"></span> LEARN AT YOUR PACE</div>
              <h2>Big ideas.<br /><em>Made easier to see.</em></h2>
              <p>Visual explainers and short educational videos will turn complex topics into learning that feels natural, memorable, and easy to share.</p>
              <span class="coming-soon">VIDEO LIBRARY COMING SOON</span>
            </div>
            <div class="watch-art" aria-hidden="true">
              <div class="watch-art-circle circle-a"></div>
              <div class="watch-art-circle circle-b"></div>
              <div class="play-tile"><span>▶</span></div>
              <div class="watch-art-label">WATCH<br />& LEARN</div>
              <div class="watch-art-spark">✳</div>
            </div>
          </div>
        </section>

        <section class="content-section about-section" id="about">
          <div class="about-mark"><img src="/brand/ridwanah-mark.svg" alt="" width="68" height="68" /></div>
          <div class="about-copy">
            <div class="eyebrow"><span class="eyebrow-line"></span> WHY RIDWANAH EXISTS</div>
            <h2>Informed people are <em>better equipped.</em></h2>
            <p>Ridwanah exists to make health education easier to access, understand, and act on. Our goal is to help people build knowledge, support prevention, and recognise when professional medical advice matters.</p>
          </div>
          <div class="about-quote">
            <span class="quote-mark">“</span>
            <p>Your health.<br />Your knowledge.<br /><strong>Your wellbeing.</strong></p>
          </div>
        </section>

        <section class="disclaimer-panel" id="standards">
          <div class="disclaimer-icon">i</div>
          <div><strong>A note about health information</strong><p>Ridwanah provides general health education, not personal medical advice, diagnosis, or treatment. Health articles should show credible sources and review details. Always speak with a qualified healthcare professional about your individual health needs.</p></div>
          <a href="#about">Our standards <span>↗</span></a>
        </section>

        <footer class="dashboard-footer">
          <img src="/brand/ridwanah-logo.svg" alt="Ridwanah" />
          <span>© {new Date().getFullYear()} Ridwanah. Health education with people at heart.</span>
          <a href="#overview">Back to top ↑</a>
        </footer>
      </main>
    </div>
  </div>

  <nav class="mobile-bottom-nav" aria-label="Mobile navigation">
    <a class="mobile-nav-item selected" href="#overview"><span>⌂</span><small>Home</small></a>
    <a class="mobile-nav-item" href="#education"><span>▤</span><small>Learn</small></a>
    <a class="mobile-nav-item" href="#prevention"><span>＋</span><small>Prevent</small></a>
    <a class="mobile-nav-item" href="#watch"><span>▷</span><small>Watch</small></a>
    <a class="mobile-nav-item" href="#about"><span>♡</span><small>About</small></a>
  </nav>
</BaseLayout>
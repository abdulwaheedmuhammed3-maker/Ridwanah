---
import BaseLayout from "../layouts/BaseLayout.astro";

const topics = [
  { number: "01", title: "Understand your health", text: "Build a stronger foundation with clear explanations of how the body works.", tag: "Health basics" },
  { number: "02", title: "Make prevention practical", text: "Explore everyday habits, screenings, hygiene, and ways to reduce health risks.", tag: "Prevention" },
  { number: "03", title: "Feel informed, not overwhelmed", text: "Find respectful, accessible guidance on topics that affect everyday life.", tag: "Wellbeing" }
];

const areas = [
  { title: "Health education", text: "Straightforward explainers that make health topics easier to understand.", icon: "✳", href: "#education" },
  { title: "Prevention & healthy living", text: "Practical information for building healthier everyday habits.", icon: "＋", href: "#prevention" },
  { title: "Watch & learn", text: "Short videos and visual explainers designed to make learning stick.", icon: "▷", href: "#watch" },
  { title: "Health awareness", text: "Campaigns and important public-health conversations, made clearer.", icon: "◎", href: "#awareness" }
];
---
<BaseLayout>
  <div class="announcement">
    <span class="announcement-dot"></span>
    Health knowledge for real life
    <span class="announcement-divider">/</span>
    Clear. Practical. Responsible.
  </div>

  <header class="site-header">
    <a class="brand" href="/" aria-label="Ridwanah home">
      <img src="/brand/ridwanah-logo.svg" alt="Ridwanah — Digital Health Education" />
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="#education">Explore health</a>
      <a href="#prevention">Prevention</a>
      <a href="#watch">Watch & learn</a>
      <a href="#about">About</a>
    </nav>
    <a class="header-cta" href="#education">Start exploring <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Mobile menu" aria-expanded="false" aria-controls="mobile-navigation">☰</button>
  </header>

  <nav class="mobile-nav" id="mobile-navigation" aria-label="Mobile navigation">
    <a href="#education">Explore health</a>
    <a href="#prevention">Prevention</a>
    <a href="#watch">Watch & learn</a>
    <a href="#about">About Ridwanah</a>
  </nav>

  <main>
    <section class="hero section-shell">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> YOUR HEALTH, MADE CLEARER</div>
        <h1>Know more.<br /><span>Live healthier.</span></h1>
        <p class="hero-description">Good health decisions begin with good information. Explore clear, practical health education that helps you understand your body, make informed choices, and know when to seek professional care.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#education">Explore health topics <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#about">Get to know Ridwanah <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-note"><span class="note-icon">✳</span><span>Reliable knowledge. Everyday language. A healthier you.</span></div>
      </div>

      <div class="hero-visual" aria-label="Ridwanah health education principles">
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>
        <div class="visual-card main-visual-card">
          <div class="visual-topline"><span>THE RIDWANAH WAY</span><span class="live-dot"></span></div>
          <div class="visual-symbol">
            <div class="symbol-circle"><span>+</span></div>
            <div class="symbol-pulse"><i></i><b></b><i></i></div>
          </div>
          <p class="visual-title">Health information<br /><em>you can understand.</em></p>
          <div class="visual-bottom"><span>LEARN</span><span>PREVENT</span><span>THRIVE</span></div>
        </div>
        <div class="floating-card floating-card-top"><span class="floating-icon mint-icon">✳</span><span><strong>Learn with clarity</strong><small>Simple, useful explanations</small></span></div>
        <div class="floating-card floating-card-bottom"><span class="floating-icon coral-icon">♡</span><span><strong>Put knowledge to use</strong><small>Small steps for everyday life</small></span></div>
        <div class="visual-caption">HEALTH EDUCATION, REIMAGINED</div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Our content principles">
      <div><span class="trust-icon">✓</span> Evidence-informed content</div>
      <div><span class="trust-icon">◎</span> Clear, accessible language</div>
      <div><span class="trust-icon">♡</span> People-first education</div>
    </section>

    <section class="intro-section section-shell" id="education">
      <div class="section-heading">
        <div>
          <div class="eyebrow"><span class="eyebrow-line"></span> A BETTER WAY TO LEARN</div>
          <h2>Health knowledge<br />should feel <em>within reach.</em></h2>
        </div>
        <p>Not medical jargon. Not confusing advice. Just approachable education to help you ask better questions and take more informed steps.</p>
      </div>
      <div class="topic-grid">
        {topics.map((topic) => (
          <article class="topic-card">
            <div class="topic-card-top"><span>{topic.number}</span><span class="topic-arrow">↗</span></div>
            <div class="topic-tag">{topic.tag}</div>
            <h3>{topic.title}</h3>
            <p>{topic.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="explore-section" id="prevention">
      <div class="section-shell explore-inner">
        <div class="explore-heading">
          <div class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> EXPLORE RIDWANAH</div>
          <h2>Curiosity is a<br /><em>healthy beginning.</em></h2>
          <p>Choose an area to explore. We’re building a growing library of useful, carefully sourced health education.</p>
          <a class="button button-light" href="#about">Our approach <span aria-hidden="true">↗</span></a>
        </div>
        <div class="area-grid">
          {areas.map((area, index) => (
            <a class="area-card" href={area.href}>
              <div class="area-card-top"><span class="area-icon">{area.icon}</span><span class="area-index">0{index + 1}</span></div>
              <h3>{area.title}</h3>
              <p>{area.text}</p>
              <span class="area-link">Explore <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="watch-section section-shell" id="watch">
      <div class="watch-panel">
        <div class="watch-content">
          <div class="eyebrow"><span class="eyebrow-line"></span> LEARN AT YOUR PACE</div>
          <h2>Big ideas.<br /><em>Made easier to see.</em></h2>
          <p>Visual explainers and short educational videos will turn complex topics into learning that feels natural, memorable, and easy to share.</p>
          <span class="coming-soon">VIDEO LIBRARY COMING SOON</span>
        </div>
        <div class="watch-art" aria-hidden="true">
          <div class="watch-art-circle circle-a"></div>
          <div class="watch-art-circle circle-b"></div>
          <div class="play-tile"><span>▶</span></div>
          <div class="watch-art-label">WATCH<br />& LEARN</div>
          <div class="watch-art-spark">✳</div>
        </div>
      </div>
    </section>

    <section class="about-section section-shell" id="about">
      <div class="about-mark"><img src="/brand/ridwanah-mark.svg" alt="" width="76" height="76" /></div>
      <div class="about-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> WHY RIDWANAH EXISTS</div>
        <h2>Informed people are<br /><em>better equipped.</em></h2>
        <p>Ridwanah exists to make health education easier to access, understand, and act on. Our goal is to help people build knowledge, support prevention, and recognise when professional medical advice matters.</p>
      </div>
      <div class="about-quote">
        <span class="quote-mark">“</span>
        <p>Your health.<br />Your knowledge.<br /><strong>Your wellbeing.</strong></p>
      </div>
    </section>

    <section class="disclaimer section-shell">
      <div class="disclaimer-icon">i</div>
      <div><strong>A note about health information</strong><p>Ridwanah provides general health education, not personal medical advice, diagnosis, or treatment. Always speak with a qualified healthcare professional about your individual health needs.</p></div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-main section-shell">
      <div class="footer-brand"><img src="/brand/ridwanah-logo.svg" alt="Ridwanah" /><p>Helping make health knowledge<br />clearer, one step at a time.</p></div>
      <div class="footer-links"><strong>Explore</strong><a href="#education">Health education</a><a href="#prevention">Prevention</a><a href="#watch">Watch & learn</a></div>
      <div class="footer-links"><strong>Ridwanah</strong><a href="#about">Our purpose</a><a href="#about">Our standards</a><span>Contact details coming soon</span></div>
      <div class="footer-signoff"><span class="footer-star">✳</span><p>Learn.<br />Prevent.<br /><em>Live healthier.</em></p></div>
    </div>
    <div class="footer-bottom section-shell"><span>© {new Date().getFullYear()} Ridwanah. All rights reserved.</span><span>Health education with people at heart.</span></div>
  </footer>

  <script>
    const toggle = document.querySelector(".menu-toggle");
    const mobileNav = document.querySelector(".mobile-nav");
    toggle?.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      if (isOpen) mobileNav?.classList.remove("is-open");
      else mobileNav?.classList.add("is-open");
    });
    mobileNav?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileNav?.classList.remove("is-open");
        toggle?.setAttribute("aria-expanded", "false");
      });
    });
  </script>
</BaseLayout>
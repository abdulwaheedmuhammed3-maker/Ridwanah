---
import LibraryLayout from "../../layouts/LibraryLayout.astro";
import { articles } from "../../data/articles";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
---
<LibraryLayout title={`${article.title} — Ridwanah`} description={article.description}>
  <article class="article-page" id="top">
    <div class="library-breadcrumb"><a href="/">Home</a><span>/</span><a href="/health">Health library</a><span>/</span><span>Reading guide</span></div>

    <a class="article-back-link" href="/health">← Back to health library</a>

    <header class="article-header">
      <div class="eyebrow"><span class="eyebrow-line"></span> {article.categoryLabel.toUpperCase()}</div>
      <h1>{article.title}</h1>
      <p class="article-deck">{article.description}</p>
      <div class="article-header-meta">
        <span>{article.readTime}</span>
        <i></i>
        <span>Published {article.publishedAt}</span>
      </div>
    </header>

    <div class="article-review-banner">
      <span class="review-banner-icon">i</span>
      <div><strong>Educational draft — medical review pending</strong><p>This guide summarises the cited public-health sources. It has not yet been reviewed by a qualified Ridwanah medical reviewer.</p></div>
    </div>

    <div class="article-reading-layout">
      <div class="article-main-column">
        <section class="article-keypoints">
          <div class="keypoints-heading"><span>✳</span><strong>Key points to remember</strong></div>
          <ul>
            {article.takeaways.map((takeaway) => <li>{takeaway}</li>)}
          </ul>
        </section>

        <div class="article-body">
          {article.sections.map((section) => (
            <section class="article-section">
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              )}
            </section>
          ))}
        </div>

        <section class="article-sources">
          <div class="eyebrow"><span class="eyebrow-line"></span> REFERENCES & FURTHER READING</div>
          <h2>Sources used for this guide</h2>
          <p>The information above is adapted into plain language from the following public-health sources. Follow the links for the original guidance.</p>
          <ol>
            {article.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <span aria-hidden="true">↗</span></a>
                <small>{source.organisation} · {source.sourceDate}</small>
              </li>
            ))}
          </ol>
        </section>

        <section class="article-disclaimer">
          <strong>Important</strong>
          <p>This article is for general education only. It is not a diagnosis, a treatment plan or a substitute for advice from a qualified healthcare professional. Seek individual guidance for personal health concerns.</p>
        </section>
        <a class="article-back-link article-bottom-back" href="/health">← Explore more health guides</a>
      </div>

      <aside class="article-aside">
        <div class="article-aside-card">
          <span class="aside-label">AT A GLANCE</span>
          <div><small>Topic</small><strong>{article.category}</strong></div>
          <div><small>Reading time</small><strong>{article.readTime}</strong></div>
          <div><small>Published</small><strong>{article.publishedAt}</strong></div>
          <div><small>Medical review</small><strong class="pending-text">Pending</strong></div>
        </div>
        <div class="article-aside-note">
          <span>♡</span>
          <strong>Knowledge supports better questions.</strong>
          <p>Use what you learn to have an informed conversation with a qualified healthcare professional.</p>
        </div>
        <a class="article-aside-link" href="/health">Browse all topics <span>↗</span></a>
      </aside>
    </div>
  </article>
</LibraryLayout>
---
import BaseLayout from "./BaseLayout.astro";
import "../styles/experience.css";

type Section =
  | "home" | "discover" | "play" | "ask" | "my-health" | "alert"
  | "health" | "news" | "watch" | "prevention" | "awareness"
  | "about" | "editorial" | "privacy" | "disclaimer" | "terms";

interface Props {
  title?: string;
  description?: string;
  activeSection?: Section;
  robots?: string;
}

const {
  title = "RIDWANAH — Your health, your vibe, your space",
  description = "Discover health stories, short lessons, quizzes and practical wellbeing tools from RIDWANAH.",
  activeSection = "home",
  robots
} = Astro.props;

const sectionTitles: Record<Section, string> = {
  home: "Your space",
  discover: "Discover",
  play: "Play & learn",
  ask: "Ask RIDWANAH",
  "my-health": "My Health",
  alert: "RIDWANAH Alert",
  health: "Health library",
  news: "Health news",
  watch: "Watch & learn",
  prevention: "Prevention",
  awareness: "Health awareness",
  about: "About RIDWANAH",
  editorial: "Content standards",
  privacy: "Privacy notice",
  disclaimer: "Health disclaimer",
  terms: "Terms of use"
};
const pageTitle = sectionTitles[activeSection];
const discoverActive = ["discover", "health", "watch", "prevention", "awareness"].includes(activeSection);
const alertActive = ["alert", "news"].includes(activeSection);
const isExact = (section: Section) => activeSection === section;
---
<BaseLayout title={title} description={description} robots={robots}>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="dashboard-app rw-app">
    <aside class="sidebar rw-sidebar" aria-label="RIDWANAH workspace">
      <a class="rw-brand" href="/" aria-label="RIDWANAH home">
        <img src="/brand/ridwanah-logo.svg" alt="RIDWANAH" />
        <span>YOUR EVERYDAY HEALTH SPACE</span>
      </a>

      <div class="rw-nav-label">YOUR SPACE</div>
      <nav class="sidebar-nav rw-sidebar-nav" aria-label="Primary navigation">
        <a class:list={["nav-item", "rw-nav-item", isExact("home") && "active"]} href="/" aria-current={isExact("home") ? "page" : undefined}><span class="rw-nav-icon" aria-hidden="true">⌂</span><span>Home</span></a>
        <a class:list={["nav-item", "rw-nav-item", discoverActive && "active"]} href="/discover" aria-current={isExact("discover") ? "page" : undefined}><span class="rw-nav-icon" aria-hidden="true">✳</span><span>Discover</span></a>
        <a class:list={["nav-item", "rw-nav-item", isExact("play") && "active"]} href="/play" aria-current={isExact("play") ? "page" : undefined}><span class="rw-nav-icon" aria-hidden="true">◇</span><span>Play & learn</span></a>
        <a class:list={["nav-item", "rw-nav-item", isExact("ask") && "active"]} href="/ask" aria-current={isExact("ask") ? "page" : undefined}><span class="rw-nav-icon" aria-hidden="true">✦</span><span>Ask RIDWANAH</span><span class="rw-nav-mini">AI preview</span></a>
        <a class:list={["nav-item", "rw-nav-item", isExact("my-health") && "active"]} href="/my-health" aria-current={isExact("my-health") ? "page" : undefined}><span class="rw-nav-icon" aria-hidden="true">♡</span><span>My Health</span></a>
      </nav>

      <div class="rw-nav-label rw-nav-label-spaced">EXPLORE</div>
      <nav class="sidebar-nav rw-sidebar-nav" aria-label="Explore navigation">
        <a class:list={["nav-item", "rw-nav-item", isExact("health") && "active"]} href="/health" aria-current={isExact("health") ? "page" : undefined}><span class="rw-nav-icon" aria-hidden="true">▤</span><span>Health library</span></a>
        <a class:list={["nav-item", "rw-nav-item", alertActive && "active"]} href="/alert" aria-current={isExact("alert") ? "page" : undefined}><span class="rw-nav-icon" aria-hidden="true">◉</span><span>RIDWANAH Alert</span></a>
        <a class:list={["nav-item", "rw-nav-item", isExact("watch") && "active"]} href="/watch" aria-current={isExact("watch") ? "page" : undefined}><span class="rw-nav-icon" aria-hidden="true">▷</span><span>Watch & learn</span></a>
        <a class:list={["nav-item", "rw-nav-item", isExact("news") && "active"]} href="/news" aria-current={isExact("news") ? "page" : undefined}><span class="rw-nav-icon" aria-hidden="true">▧</span><span>Health news</span></a>
      </nav>

      <div class="rw-sidebar-note">
        <span class="rw-sidebar-note-icon" aria-hidden="true">✳</span>
        <strong>Good info. No judgement.</strong>
        <p>Learn at your pace. Your health questions deserve clear, respectful answers.</p>
        <a href="/editorial-policy">How we handle health info <span aria-hidden="true">↗</span></a>
      </div>
      <div class="sidebar-copyright rw-sidebar-copyright">© {new Date().getFullYear()} RIDWANAH</div>
    </aside>

    <div class="main-column rw-main-column">
      <header class="topbar rw-topbar">
        <div class="topbar-context rw-topbar-context">
          <span class="rw-topbar-brand">RIDWANAH <span aria-hidden="true">/</span></span>
          <span class="topbar-current">{pageTitle}</span>
        </div>
        <div class="topbar-right rw-topbar-right">
          <span class="rw-topbar-note">HEALTH, WITHOUT THE LECTURE.</span>
          <a class="rw-alert-cta" href="/alert"><span aria-hidden="true">◉</span> RIDWANAH Alert <span aria-hidden="true">↗</span></a>
        </div>
      </header>

      <main class="dashboard-content rw-dashboard-content" id="main-content">
        <slot />
        <footer class="rw-footer">
          <a href="/" class="rw-footer-brand">RIDWANAH<span>®</span></a>
          <p>Your health. Your vibe. Your space.</p>
          <nav aria-label="Footer navigation">
            <a href="/about">About</a><a href="/editorial-policy">Our standards</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a>
          </nav>
          <small>General health education, not a diagnosis or personal medical advice.</small>
        </footer>
      </main>
    </div>

    <nav class="mobile-bottom-nav rw-mobile-nav" aria-label="Mobile navigation">
      <a class:list={["mobile-nav-item", "rw-mobile-nav-item", isExact("home") && "selected"]} href="/" aria-current={isExact("home") ? "page" : undefined}><span aria-hidden="true">⌂</span><small>Home</small></a>
      <a class:list={["mobile-nav-item", "rw-mobile-nav-item", discoverActive && "selected"]} href="/discover" aria-current={isExact("discover") ? "page" : undefined}><span aria-hidden="true">✳</span><small>Discover</small></a>
      <a class:list={["mobile-nav-item", "rw-mobile-nav-item", isExact("play") && "selected"]} href="/play" aria-current={isExact("play") ? "page" : undefined}><span aria-hidden="true">◇</span><small>Play</small></a>
      <a class:list={["mobile-nav-item", "rw-mobile-nav-item", isExact("ask") && "selected"]} href="/ask" aria-current={isExact("ask") ? "page" : undefined}><span aria-hidden="true">✦</span><small>Ask</small></a>
      <a class:list={["mobile-nav-item", "rw-mobile-nav-item", isExact("my-health") && "selected"]} href="/my-health" aria-current={isExact("my-health") ? "page" : undefined}><span aria-hidden="true">♡</span><small>My Health</small></a>
    </nav>
  </div>
</BaseLayout>

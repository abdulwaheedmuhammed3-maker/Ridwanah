---
import BaseLayout from "./BaseLayout.astro";
import "../styles/library.css";
import "../styles/readability.css";

interface Props {
  title?: string;
  description?: string;
  activeSection?: "health" | "news" | "watch" | "prevention" | "awareness" | "about" | "editorial" | "privacy" | "disclaimer" | "terms";
  robots?: string;
}

const {
  title = "Health Library — Ridwanah",
  description = "Explore clear, evidence-informed health education from Ridwanah.",
  activeSection = "health",
  robots = "index, follow, max-image-preview:large"
} = Astro.props;

const sectionTitles = {
  health: "Health library",
  news: "Health news",
  watch: "Watch & learn",
  prevention: "Prevention & healthy living",
  awareness: "Health awareness",
  about: "About Ridwanah",
  editorial: "Editorial policy",
  privacy: "Privacy notice",
  disclaimer: "Health disclaimer",
  terms: "Terms of use"
} as const;
const sectionTitle = sectionTitles[activeSection];
---
<BaseLayout title={title} description={description} robots={robots}>

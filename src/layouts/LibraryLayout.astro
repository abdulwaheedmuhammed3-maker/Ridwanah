---
import ExperienceLayout from "./ExperienceLayout.astro";
import "../styles/library.css";
import "../styles/readability.css";
import "../styles/experience.css";

interface Props {
  title?: string;
  description?: string;
  activeSection?: "health" | "news" | "watch" | "prevention" | "awareness" | "about" | "editorial" | "privacy" | "disclaimer" | "terms";
  robots?: string;
}

const {
  title = "Health Library — RIDWANAH",
  description = "Explore clear, evidence-informed health education from RIDWANAH.",
  activeSection = "health",
  robots
} = Astro.props;
---
<ExperienceLayout title={title} description={description} activeSection={activeSection} robots={robots}>
  <slot />
</ExperienceLayout>

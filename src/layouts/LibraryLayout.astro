---
import BaseLayout from "./BaseLayout.astro";
import "../styles/library.css";
import "../styles/readability.css";

interface Props {
  title?: string;
  description?: string;
  activeSection?: "health" | "news" | "watch" | "prevention" | "awareness" | "about" | "editorial" | "privacy" | "disclaimer" | "terms";
}

const {
  title = "Health Library — Ridwanah",
  description = "Explore clear, evidence-informed health education from Ridwanah.",
  activeSection = "health"
} = Astro.props;

const sectionTitles = {
  health: "Health library",
  news: "Health news",
  watch: "Watch & learn",
  prevention: "Prevention & healthy living",
  awareness: "Health awareness",
  about: "About Ridwanah",
  editorial: "Editorial policy",
  privacy: "Privacy notice",
  disclaimer: "Health disclaimer",
  terms: "Terms of use"
} as const;
const sectionTitle = sectionTitles[activeSection];
---
<BaseLayout title={title} description={description}>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="dashboard-app">
    <aside class="sidebar" aria-label="Main sidebar">
      <a class="sidebar-brand" href="/" aria-label="Ridwanah home">
        <img src="/brand/ridwanah-logo.svg" alt="Ridwanah — Digital Health Education" />
      </a>
      <div class="sidebar-label">WORKSPACE</div>
      <nav class="sidebar-nav" aria-label="Desktop navigation">
        <a class="nav-item" href="/"><span class="nav-icon">⌂</span><span>Overview</span></a>
        <a class:list={["nav-item", activeSection === "health" && "active"]} href="/health"><span class="nav-icon">▤</span><span>Health library</span>{activeSection === "health" && <span class="nav-current"></span>}</a>
        <a class:list={["nav-item", activeSection === "news" && "active"]} href="/news"><span class="nav-icon">◉</span><span>Health news</span>{activeSection === "news" && <span class="nav-current"></span>}</a>
        <a class:list={["nav-item", activeSection === "prevention" && "active"]} href="/prevention"><span class="nav-icon">＋</span><span>Prevention</span>{activeSection === "prevention" && <span class="nav-current" />}</a>
        <a class:list={["nav-item", activeSection === "watch" && "active"]} href="/watch"><span class="nav-icon">▷</span><span>Watch & learn</span>{activeSection === "watch" && <span class="nav-current" />}</a>
        <a class:list={["nav-item", activeSection === "awareness" && "active"]} href="/awareness"><span class="nav-icon">◎</span><span>Awareness</span>{activeSection === "awareness" && <span class="nav-current" />}</a>
      </nav>
      <div class="sidebar-label sidebar-label-spaced">DISCOVER</div>
      <nav class="sidebar-nav" aria-label="Discover navigation">
        <a class:list={["nav-item", activeSection === "about" && "active"]} href="/about"><span class="nav-icon">♡</span><span>About Ridwanah</span>{activeSection === "about" && <span class="nav-current" />}</a>
        <a class:list={["nav-item", activeSection === "editorial" && "active"]} href="/editorial-policy"><span class="nav-icon">✓</span><span>Editorial standards</span>{activeSection === "editorial" && <span class="nav-current" />}</a>
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-tip-icon">✳</div>
        <strong>Knowledge is a healthy start.</strong>
        <p>Learn at your pace. Ask questions. Speak with a qualified professional when you need personal care.</p>
        <a href="/editorial-policy">Our approach <span>↗</span></a>
      </div>
      <div class="sidebar-copyright">© {new Date().getFullYear()} Ridwanah</div>
    </aside>

    <div class="main-column">
      <header class="topbar">
        <div class="topbar-context">
          <span class="topbar-kicker">RIDWANAH /</span>
          <span class="topbar-current">{sectionTitle}</span>
        </div>
        <div class="topbar-right">
          <span class="topbar-status"><i></i> General health education</span>
          <a class="topbar-cta" href={activeSection === "news" ? "/health" : "/news"}>{activeSection === "news" ? "Explore library" : "Read health news"} <span>↗</span></a>
        </div>
      </header>
      <main class="dashboard-content library-content" id="main-content">
        <slot />
        <footer class="dashboard-footer">
          <img src="/brand/ridwanah-logo.svg" alt="Ridwanah" />
          <span>© {new Date().getFullYear()} Ridwanah. Health education with people at heart.</span>
          <nav class="footer-links" aria-label="Footer links">
            <a href="/about">About</a>
            <a href="/editorial-policy">Editorial policy</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
          </nav>
          <a href="#top">Back to top ↑</a>
        </footer>
      </main>
    </div>
  </div>

  <nav class="mobile-bottom-nav" aria-label="Mobile navigation">
    <a class="mobile-nav-item" href="/"><span>⌂</span><small>Home</small></a>
    <a class:list={["mobile-nav-item", activeSection === "health" && "selected"]} href="/health"><span>▤</span><small>Learn</small></a>
    <a class:list={["mobile-nav-item", activeSection === "news" && "selected"]} href="/news"><span>◉</span><small>News</small></a>
    <a class:list={["mobile-nav-item", activeSection === "watch" && "selected"]} href="/watch"><span>▷</span><small>Watch</small></a>
    <a class:list={["mobile-nav-item", activeSection === "about" && "selected"]} href="/about"><span>♡</span><small>About</small></a>
  </nav>
</BaseLayout>